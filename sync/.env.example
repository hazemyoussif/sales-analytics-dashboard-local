# Copy to sync/.env and fill in. Never commit the filled copy.

# The odoo-engine. Local while testing; its deployed URL in production.
ENGINE_URL=http://127.0.0.1:8000
ENGINE_API_KEY=

# Supabase. This MUST be the service_role key, not the anon key: this process
# writes, and row-level security denies the anon role every table it touches.
# That is also why nothing here may ever be shipped to a browser.
SUPABASE_URL=https://jxihpdjyquyttscqzcid.supabase.co
SUPABASE_SERVICE_KEY=

# Drives the stock-history snapshot date. A 03:00 Baghdad run is still the
# previous day in UTC, and stamping it as such would put two snapshots on one
# date and none on another.
TIMEZONE=Asia/Baghdad
